{
  "version": 2,
  "alias": "shifl-screenshot-service.now.sh",
  "builds": [
    {
      "src": "screenshot.js",
      "use": "@now/node@0.11.1",
      "config": {
        "maxLambdaSize": "40mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.+)",
      "dest": "/screenshot.js"
    }
  ]
}
