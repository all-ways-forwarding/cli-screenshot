{
  "version": 2,
  "alias": "shifl-screenshot-service.now.sh",
  "builds": [
    {
      "src": "screenshot.js",
      "use": "@now/node",
      "config": {
        "maxLambdaSize": "40mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.+)",
      "dest": "/screenshot.js"
    }
  ],
  "env": {
    "BROWSERLESS_TOKEN": "@browserlesstoken",
    "APP_ENV": "@screenshot-env"
  }
}
